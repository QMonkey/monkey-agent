# Machine-local values — never commit (the real file lives outside this
# checkout, at ~/.config/env/agent.env; this is belt-and-suspenders).
agent.env

# Backups made when the installer replaces a foreign config file
# (link_config takeover mode moves the original to <dst>.link-bak).
*.link-bak

# Editor / OS droppings.
*.swp
*~
.DS_Store

# Qwen Code session scratch created when a session runs with this checkout
# as its project root (one-off probes, render sandboxes) — never project code.
.qwen/
