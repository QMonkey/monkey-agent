{
  "agents": {
    "defaults": {
      "workspace": "$__OPENCLAW_WORKSPACE__",
      "model": {
        "primary": "$__OPENCLAW_PRIMARY_MODEL__"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "custom": {
        "baseUrl": "$__OPENCLAW_LLM_BASE_URL__",
        "apiKey": "${$__OPENCLAW_LLM_API_KEY_ENV_NAME__}",
        "api": "openai-completions",
        "authHeader": true,
        "models": [
          {
            "id": "$__OPENCLAW_LLM_MODEL__",
            "name": "$__OPENCLAW_LLM_MODEL__",
            "api": "openai-completions",
            "reasoning": true,
            "input": ["text"],
            $__OPENCLAW_LLM_EFFORT__
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": $__OPENCLAW_LLM_CTX__,
            "maxTokens": $__OPENCLAW_LLM_OUT__
          }
        ]
      }
    }
  },
  "channels": {
$__OPENCLAW_CHANNELS__
  },
  "cron": {
    "enabled": true,
    "sessionRetention": "24h"
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
$__OPENCLAW_GATEWAY_AUTH__
    "reload": { "mode": "hybrid" }
  }
}
