{
  "agents": {
    "defaults": {
      "workspace": {{ .Env.OPENCLAW_WORKSPACE | toJSON }},
      "model": {
        "primary": {{ .Env.OPENCLAW_PRIMARY_MODEL | toJSON }}
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "custom": {
        "baseUrl": {{ .Env.OPENCLAW_LLM_BASE_URL | toJSON }},
        "apiKey": "{{ print "${" .Env.OPENCLAW_LLM_API_KEY_ENV_NAME "}" }}",
        "api": "openai-completions",
        "authHeader": true,
        "models": [
{{- if ne .Env.OPENCLAW_LLM_MODEL_ROWS "" }}
{{- range $i, $r := (strings.Split "\n" .Env.OPENCLAW_LLM_MODEL_ROWS) }}{{ $f := (strings.Split "|" $r) }}
{{- if ne $i 0 }},{{ end }}
          {
            "id": {{ index $f 0 | toJSON }},
            "name": {{ index $f 0 | toJSON }},
            "api": "openai-completions",
            "reasoning": {{ if ne (index $f 3) "-" }}true{{ else }}false{{ end }},
{{- if and (ne (index $f 3) "-") (ne (index $f 3) "") }}
            "compat": { "supportedReasoningEfforts": [{{ range $j, $e := (strings.Split "," (index $f 3)) }}{{ if ne $j 0 }},{{ end }}{{ $e | toJSON }}{{ end }}] },
{{- end }}
            "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
            "contextWindow": {{ index $f 1 }},
            "maxTokens": {{ index $f 2 }}
          }
{{- end }}
{{- end }}
        ]
      }
    }
  },
  "plugins": {
    "allow": ["dingtalk-connector", "openclaw-qqbot"]
  },
  "channels": {
{{- if eq .Env.OPENCLAW_CHANNEL_DINGTALK "1" }}
    "dingtalk-connector": {
      "enabled": true,
      "clientId": "${OPENCLAW_DINGTALK_ACCESS_TOKEN}",
      "clientSecret": "${OPENCLAW_DINGTALK_SECRET}"
    }{{ if and (eq .Env.OPENCLAW_CHANNEL_DINGTALK "1") (eq .Env.OPENCLAW_CHANNEL_QQ "1") }},{{ end }}
{{- end }}
{{- if eq .Env.OPENCLAW_CHANNEL_QQ "1" }}
    "qqbot": {
      "enabled": true,
      "dmPolicy": "open",
      "appId": "${OPENCLAW_QQ_APP_ID}",
      "clientSecret": "${OPENCLAW_QQ_CLIENT_SECRET}",
      "allowFrom": [{{ range $n, $a := (strings.Split "," .Env.OPENCLAW_QQ_ALLOW_FROM) }}{{ if ne $n 0 }},{{ end }}{{ $a | toJSON }}{{ end }}]
    }
{{- end }}
  },
  "cron": {
    "enabled": true,
    "sessionRetention": "24h"
  },
  "gateway": {
    "mode": "local",
    "port": 18790,
    "bind": "loopback",
{{- if eq .Env.OPENCLAW_GATEWAY_AUTH "1" }}
    "auth": { "mode": "token", "token": "${OPENCLAW_GATEWAY_TOKEN}" },
{{- end }}
    "reload": { "mode": "hybrid" }
  }
}
