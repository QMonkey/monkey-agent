# ~/.config/agent/secrets.env — the credential store for every agent.
# install.sh renders this template to the real file (0600, gitignored):
# values come from environment variables exported before the install runs,
# empty placeholders otherwise. Fill by hand or re-run the installer with
# the variables exported — values already in the file are never
# overwritten.
#
# Layers: LLM_* is the shared default LLM backend (key/endpoint/model);
# an agent overrides per field with <AGENT>_LLM_* — empty fields fall
# back to the shared layer. LLM_MODELS is the switchable model catalog
# (comma-separated ids on the same gateway); empty = LLM_MODEL only.
#
# Values are written bare; whitespace/quotes get auto-quoted on write.
# Keep this file free of newlines inside values — a newline breaks every
# KEY= line below it.

# ── shared LLM backend ──
# LLM_MODEL is the model ID exactly as the gateway API expects it (vendor
# prefixes included, e.g. "zhipu/glm-5.3-flash"); no agent-side prefixes
# (opencode adds its own "llm/").
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MODELS=

# ── per-agent LLM overrides (optional, per field) ──
# OpenCode
OPENCODE_LLM_API_KEY=
OPENCODE_LLM_BASE_URL=
OPENCODE_LLM_MODEL=

# DSH (DeepSeek Harness, web profile)
DSH_LLM_API_KEY=
DSH_LLM_BASE_URL=
DSH_LLM_MODEL=

# Qwen Code
QWEN_LLM_API_KEY=
QWEN_LLM_BASE_URL=
QWEN_LLM_MODEL=

# OpenClaw
OPENCLAW_LLM_API_KEY=
OPENCLAW_LLM_BASE_URL=
OPENCLAW_LLM_MODEL=

# ── Qwen Code channels ──
# QQ Bot: AppID + AppSecret from the QQ Bot Open Platform (q.qq.com).
# Empty = QR-code login on the channel's first start.
QWEN_QQ_APP_ID=
QWEN_QQ_APP_SECRET=

# DingTalk bot (Stream mode): Client ID (AppKey) + Client Secret from
# open-dev.dingtalk.com. Empty = the channel is not rendered.
QWEN_DINGTALK_ACCESS_TOKEN=
QWEN_DINGTALK_SECRET=

# Serve bearer token: auto-generated when empty (openssl rand -hex 32).
# Emptying it by hand reverts to token-less loopback (warned).
QWEN_SERVER_TOKEN=

# ── OpenClaw channels ──
# DingTalk bot (Stream mode): Client ID + Client Secret, an independent
# app — never shared with Qwen's.
OPENCLAW_DINGTALK_ACCESS_TOKEN=
OPENCLAW_DINGTALK_SECRET=

# QQ Bot (the official tencent-connect plugin): AppID + Client Secret
# from the QQ Bot Open Platform; ALLOW_FROM = comma-separated numeric QQ
# ids allowed to talk to the bot (required, no wildcards).
OPENCLAW_QQ_APP_ID=
OPENCLAW_QQ_CLIENT_SECRET=
OPENCLAW_QQ_ALLOW_FROM=

# Gateway control-plane token: auto-generated when empty; emptying by
# hand reverts to token-less loopback (warned).
OPENCLAW_GATEWAY_TOKEN=

# ── daemon egress proxy (resident systemd units only) ──
# Resident daemons inherit the user manager's environment, which never has
# proxy variables. Fill the two proxy lines (URL with credentials allowed)
# and restart the units; they are re-read on every start, so edits never
# require an installer re-run. Keep in sync with the shell's proxy
# configuration. NO_PROXY must keep the loopback binds off the proxy. The
# installer fills the proxy lines from its own environment when present; a
# network without a proxy leaves them empty.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
