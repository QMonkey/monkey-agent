# ~/.config/agent/secrets.env — example template.
#
# install.sh generates the real file (0600, gitignored) at
# $HOME/.config/agent/secrets.env: values come from environment variables
# exported before the install runs, empty placeholders otherwise. Fill by
# hand, or re-run the installer with the variables exported — values
# already in the file are never overwritten.
#
# Layers: LLM_* is the shared default LLM backend (API key, endpoint,
# model). An agent that needs a different backend overrides per field with
# <AGENT>_LLM_* — any field it leaves empty falls back to the shared layer,
# so overriding one field never requires writing the full triple.
#
# Public values (e.g. an official endpoint URL, a public model id) may be
# written directly into the config templates instead — only secret fields
# need to live here.

# ── shared LLM backend (default for every agent) ──
# Shared LLM backend (defaults for every agent). LLM_MODEL is the model ID
# exactly as the gateway's API expects it — vendor prefixes included
# (e.g. "deepseek/deepseek-v4.1-flash", "zhipu/glm-5.3-flash"); do NOT add
# any agent-side provider prefix (opencode's "llm/" is added by the config
# itself).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── OpenCode overrides (optional, per field) ──
OPENCODE_LLM_API_KEY=
OPENCODE_LLM_BASE_URL=
OPENCODE_LLM_MODEL=

# ── DSH overrides (optional, per field) ──
DSH_LLM_API_KEY=
DSH_LLM_BASE_URL=
DSH_LLM_MODEL=

# ── Qwen Code overrides (optional, per field) ──
QWEN_LLM_API_KEY=
QWEN_LLM_BASE_URL=
QWEN_LLM_MODEL=
# QQ Bot channel (type "qq" in settings.json): AppID + AppSecret from the
# QQ Bot Open Platform (q.qq.com). Both render as $VAR by-name references;
# leave empty to use QR-code login on the channel's first start instead.
QWEN_QQ_APP_ID=
QWEN_QQ_APP_SECRET=
# Qwen Code dingtalk channel credentials — an independent dingtalk app,
# never shared with the OpenClaw channel below.
QWEN_DINGTALK_ACCESS_TOKEN=
QWEN_DINGTALK_SECRET=

# ── OpenClaw overrides (optional, per field) ──
OPENCLAW_LLM_API_KEY=
OPENCLAW_LLM_BASE_URL=
OPENCLAW_LLM_MODEL=
# OpenClaw dingtalk channel credentials — an independent dingtalk app,
# never shared with the Qwen Code channel above.
OPENCLAW_DINGTALK_ACCESS_TOKEN=
OPENCLAW_DINGTALK_SECRET=
# QQ Bot channel (the official @tencent-connect/openclaw-qqbot plugin):
# the upstream's OWN default-account env names — no config fields needed.
# AppID + AppSecret from the QQ Bot Open Platform (q.qq.com).
QQBOT_APP_ID=
QQBOT_CLIENT_SECRET=
