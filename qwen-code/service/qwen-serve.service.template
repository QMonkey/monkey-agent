[Unit]
Description=Qwen Code serve daemon (DingTalk channel + loopback HTTP + SSE, Web Shell)
Documentation=https://qwenlm.github.io/qwen-code-docs/users/qwen-serve/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile={{ .Env.HOME }}/.config/env/agent.env
ExecStart={{ .Env.QWEN_BIN }} serve{{ .Env.QWEN_CHANNEL_ARGS }} --hostname 127.0.0.1 --port 4170{{ .Env.QWEN_SERVE_AUTH_FLAG }}
Environment=PATH={{ .Env.QWEN_SERVICE_PATH }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
