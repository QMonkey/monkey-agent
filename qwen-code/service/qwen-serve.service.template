# Qwen Code serve daemon — systemd USER unit template. Rendered at install
# to ~/.config/systemd/user/qwen-serve.service.
#
# RESEARCH (pinned 2026-10-24, docs/users/qwen-serve.md +
# users/qwen-serve-deploy-local.md):
#   - `qwen serve --channel` = ONE resident process hosting the loopback
#     HTTP+SSE daemon (Web Shell at http://127.0.0.1:4170/, v0.16-alpha)
#     AND the channel adapters (daemon-managed channel lifecycle).
#   - AUTH POSTURE: the official local-launch template generates a bearer
#     token once (openssl rand -hex 32), wraps it in a chmod-600 env file
#     and points EnvironmentFile= at it — never inlining the token in the
#     world-readable unit. On a token-less loopback bind "any local
#     process that can reach the port can use the full operator API,
#     including executing code as the daemon user". THIS repo's posture:
#     QWEN_SERVER_TOKEN is auto-generated at install (fill-empty-only —
#     a hand-set value always wins), persisted in the 0600 secrets.env
#     this file reads via EnvironmentFile=; the daemon boots with
#     --require-auth. Emptying the variable by hand reverts to token-less
#     (the installer warns about the exposure).
#   - Unit shape mirrors the official local-launch template: Type=simple,
#     Restart=on-failure, absolute ExecStart (systemd does not read the
#     shell's PATH), %h-free literal $__HOME__ resolution at render time.
#   - Registration (install.sh, best-effort): daemon-reload + enable --now
#     + loginctl enable-linger; skipped with a WARN on hosts without a
#     systemd user session (WSL/containers) — the unit file still lands.

[Unit]
Description=Qwen Code serve daemon (DingTalk channel + loopback HTTP + SSE, Web Shell)
Documentation=https://qwenlm.github.io/qwen-code-docs/users/qwen-serve/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=$__HOME__/.config/agent/secrets.env
ExecStart=$__QWEN_BIN__ serve --channel --hostname 127.0.0.1 --port 4170$__QWEN_SERVE_AUTH_FLAG__
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
