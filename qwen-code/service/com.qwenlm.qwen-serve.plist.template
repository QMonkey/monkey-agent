<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Qwen Code serve daemon — launchd user agent template. Rendered at install
  to ~/Library/LaunchAgents/com.qwenlm.qwen-serve.plist (0600). One daemon
  hosts the loopback HTTP+SSE API (Web Shell, port 4170) AND the channels
  (via the channel flag). Shape mirrors the official local-launch template
  (docs/users/qwen-serve-deploy-local.md, macOS section): absolute
  ProgramArguments (launchd does not read the shell's PATH), PATH via
  EnvironmentVariables, KeepAlive.SuccessfulExit=false to match systemd
  Restart=on-failure (a clean SIGTERM stays stopped), ThrottleInterval
  mirroring RestartSec. Credentials are NOT inlined: launchd has no
  EnvironmentFile, so the command sources the 0600 agent.env first —
  the same file the systemd unit consumes.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qwenlm.qwen-serve</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>. '{{ .Env.HOME }}/.config/env/agent.env' || exit 1; exec '{{ .Env.QWEN_BIN }}' serve{{ .Env.QWEN_CHANNEL_ARGS }} --hostname 127.0.0.1 --port 4170{{ .Env.QWEN_SERVE_AUTH_FLAG }}</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>{{ .Env.QWEN_SERVICE_PATH }}</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>{{ .Env.HOME }}/Library/Logs/qwen-serve/out.log</string>
  <key>StandardErrorPath</key>
  <string>{{ .Env.HOME }}/Library/Logs/qwen-serve/err.log</string>
</dict>
</plist>
