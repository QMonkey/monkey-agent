- id: llm-pi-ai
  config:
    providers:
      shared-llm:
        apiKeyEnv: {{ .Env.DSH_LLM_API_KEY_ENV_NAME }}
        api: openai-completions
        baseURL: {{ .Env.DSH_LLM_BASE_URL }}
        models:
{{- if ne .Env.DSH_LLM_MODEL_ROWS "" }}
{{- range $r := (strings.Split "\n" .Env.DSH_LLM_MODEL_ROWS) }}{{ $f := (strings.Split "|" $r) }}
          - id: {{ index $f 0 }}
            contextWindow: {{ index $f 1 }}
            maxTokens: {{ index $f 2 }}
{{- if and (ne (index $f 3) "-") (ne (index $f 3) "") }}
            reasoningEfforts:
{{- range $e := (strings.Split "," (index $f 3)) }}
{{- if eq $e "none" }}
              off: none
{{- else }}
              {{ $e }}: {{ $e }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
{{- end }}
# An id-targeted override replaces the bundle's whole config block, so every
# key that must stay active is restated. rulesFile is absolute on purpose: the
# bundle's default (<cwd>/.dsh/rules.yaml) is per-session project scope, and a
# relative path would be resolved against the cwd instead of this install's
# config home.
- id: permission-rules
  config:
    rulesFile: {{ .Env.AGENT_HOME }}/dsh/rules.yaml
    badFilePolicy: fail
    maxRules: 256
    patternMode: glob
    watch: true
