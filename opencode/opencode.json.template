{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "provider": {
    "llm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LLM Gateway",
      "options": {
        "baseURL": {{ .Env.OPENCODE_LLM_BASE_URL | toJSON }},
        "apiKey": "{env:{{ .Env.OPENCODE_LLM_API_KEY_ENV_NAME }}}"
      },
      "models": {
{{- if ne .Env.OPENCODE_LLM_MODEL_ROWS "" }}
{{- range $i, $r := (strings.Split "\n" .Env.OPENCODE_LLM_MODEL_ROWS) }}{{ $f := (strings.Split "|" $r) }}
{{- if ne $i 0 }},{{ end }}
        {{ index $f 0 | toJSON }}: {
          "name": {{ index $f 0 | toJSON }},
          "reasoning": {{ if ne (index $f 3) "-" }}true{{ else }}false{{ end }},
{{- if ne (index $f 4) "" }}
          "options": { "reasoningEffort": {{ index $f 4 | toJSON }} },
{{- end }}
          "limit": {
            "context": {{ index $f 1 }},
            "output": {{ index $f 2 }}
          }
        }
{{- end }}
{{- end }}
      }
    }
  },
  "model": "llm/{{ .Env.OPENCODE_LLM_MODEL }}",
  "permission": {
    "read": "allow",
    "external_directory": {
      "*": "allow"
    },
    "bash": {
      "tmux kill-server": "ask",
      "tmux kill-server *": "ask"
    }
  }
}
